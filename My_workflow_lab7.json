    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3-70b-8192\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an assistant that extracts structured meeting details.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Extract the following structured details from the input JSON: title, date (in YYYY-MM-DD format), time (in HH:MM format), duration (in hours), sender, recipients (as a list), attendees (as a list), agenda (as a list). If a field is missing, use default values (e.g., date: '2025-05-04', time: '10:00', duration: '1 hour', title: 'Meeting'). Input: Prompt: {{ $json.data.prompt }}\\nSender: {{ $json.data.sender }}\\nRecipients: {{ $json.data.recipients }}\\nAgenda: {{ $json.data.agenda }}\"\n    }\n  ],\n  \"temperature\": 0.7\n}",
        "options": {}
      },
      "id": "8bfc180b-90db-4c84-a3cd-1da0b25791e6",
      "name": "Extract Structured Details with LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3500,
        540
      ],
      "credentials": {
        "groqApi": {
          "id": "EC9MPjJMmlTMrWNB",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "= {{$json.chatId}}",
        "text": "= {{$json.error || 'Processing meeting details...'}}",
        "additionalFields": {}
      },
      "id": "b106dc23-3bde-4768-a38e-663766111d3b",
      "name": "Handle Parse Errors",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        3400,
        860
      ],
      "webhookId": "bdd8b01c-89fa-4db4-8836-81dd03b935b8",
      "credentials": {
        "telegramApi": {
          "id": "dMgs1nxNoybEGN3E",
          "name": "Telegram account 5"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $(\"Parse JSON File\").all()[0].json.data;\nconst llmResponse = $input.first().json.choices[0].message.content;\n\nfunction parseStructuredText(text) {\n  let structuredData = {\n    date: \"2025-05-04\", // قيمة افتراضية\n    time: \"10:00\",       // قيمة افتراضية\n    duration: \"1 hour\",  // قيمة افتراضية\n    title: data.prompt || \"Meeting\" // قيمة افتراضية\n  };\n  const lines = text.split('\\n').map(line => line.trim()).filter(line => line);\n\n  lines.forEach(line => {\n    if (line.startsWith('- **')) {\n      const [key, value] = line.replace('- **', '').split('**: ');\n      if (key && value) {\n        if (value.startsWith('[') && value.endsWith(']')) {\n          structuredData[key.toLowerCase()] = JSON.parse(value);\n        } else {\n          structuredData[key.toLowerCase()] = value;\n        }\n      }\n    } else if (line.startsWith('- ')) {\n      const agendaMatch = line.match(/^- (.*)/);\n      if (agendaMatch && !structuredData.agenda) {\n        structuredData.agenda = [agendaMatch[1]];\n      } else if (agendaMatch) {\n        structuredData.agenda.push(agendaMatch[1]);\n      }\n    }\n  });\n\n  // دمج البيانات من الملف الأصلي\n  structuredData.sender = data.sender || structuredData.sender;\n  structuredData.recipients = data.recipients || structuredData.recipients;\n  structuredData.agenda = data.agenda || structuredData.agenda;\n\n  return structuredData;\n}\n\nlet parsedData;\ntry {\n  parsedData = parseStructuredText(llmResponse);\n} catch (error) {\n  return [{ json: { chatId: $json.chatId, error: `Failed to parse structured details: ${error.message}` } }];\n}\n\nreturn [{ json: parsedData }];"
      },
